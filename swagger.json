{
  "openapi": "3.0.0",
  "info": {
    "title": "Daily Food Delivery API",
    "version": "1.0.0",
    "description": "Production-ready REST API for Daily Food Delivery application featuring MongoDB Atlas, Passwordless Email OTP (Nodemailer), JWT Authentication, and Razorpay Test Mode."
  },
  "servers": [
    {
      "url": "http://localhost:5000/api",
      "description": "Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/auth/send-otp": {
      "post": {
        "summary": "Send Email OTP for authentication",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "example": "user@example.com" }
                },
                "required": ["email"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "OTP sent successfully" }
        }
      }
    },
    "/auth/verify-otp": {
      "post": {
        "summary": "Verify Email OTP and receive JWT Token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "example": "user@example.com" },
                  "otp": { "type": "string", "example": "123456" }
                },
                "required": ["email", "otp"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "OTP verified, returns token and user profile" }
        }
      }
    },
    "/products": {
      "get": {
        "summary": "Get product catalogue",
        "responses": {
          "200": { "description": "List of products" }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "summary": "Get product details by ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Product details" }
        }
      }
    },
    "/categories": {
      "get": {
        "summary": "Get all food categories",
        "responses": {
          "200": { "description": "List of categories" }
        }
      }
    },
    "/search": {
      "get": {
        "summary": "Search products by query",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Search results" }
        }
      }
    },
    "/cart": {
      "get": {
        "summary": "Get user cart",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "User cart items and promo" } }
      },
      "post": {
        "summary": "Add item to cart",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Cart updated" } }
      }
    },
    "/payment/create-order": {
      "post": {
        "summary": "Create Razorpay Order",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Razorpay order ID created" } }
      }
    },
    "/payment/verify": {
      "post": {
        "summary": "Verify Razorpay Payment signature",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Razorpay signature verified" } }
      }
    },
    "/orders": {
      "get": {
        "summary": "Get user order history",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "List of orders" } }
      },
      "post": {
        "summary": "Place order",
        "security": [{ "bearerAuth": [] }],
        "responses": { "201": { "description": "Order created, cart cleared, confirmation email sent" } }
      }
    }
  }
}
